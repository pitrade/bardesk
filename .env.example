# SPDX-License-Identifier: GPL-3.0-or-later
# ---- Bardesk self-hosting settings (copy to .env) ----

# Your domain. Its DNS must point to this server, ports 80 and 443 must be open.
DOMAIN=tab.example.org

# Where the app lives on that domain: "/" or e.g. "/tab/"
BASE_PATH=/

# ---- Look and defaults (applied when the app starts: docker compose up -d) ----
# Changes reach installed apps: they update themselves before they sync again.
# Own icon: put icon.png (square, at least 512 px) into the branding/ folder.
APP_NAME=Bardesk
# Label under the home-screen icon (max. 12 characters; default: APP_NAME)
APP_SHORT_NAME=
# Main colour (buttons, accents) and second colour (headings, notices), as #rrggbb
COLOR_PRIMARY=#d5121e
COLOR_SECONDARY=#3c3c3b
# light or dark
THEME=light
# de, en or auto (= phone language)
DEFAULT_LANGUAGE=auto
# ISO currency code: EUR, CHF, ...
CURRENCY=EUR
# Quick top-up buttons (comma-separated, up to 4)
TOPUP_AMOUNTS=5,10,20
# Legal links shown on the login screen and in the profile (needed for public sites in Germany)
IMPRINT_URL=
PRIVACY_URL=
# Name of the database on the phones (IndexedDB). A phone takes it at its first start and
# keeps it: after a change only new phones use the new name (the others show a notice).
DB_NAME=bardesk

# ---- Mail and security ----

# Mail server for login codes (any SMTP provider). Leave SMTP_HOST empty to try Bardesk
# out: no mail is sent, the login codes appear in the server log
# (docker compose logs app).
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=tab@example.org
SMTP_PASSWORD=change-me
FROM_EMAIL=tab@example.org
FROM_NAME=Bardesk

# Login code requests per minute and IP address
AUTH_RATE_LIMIT_PER_MINUTE=10

# Image version of the app (docker-compose.yaml). "0.9" follows patch updates; for a new
# minor or major version change it here.
BARDESK_VERSION=1.0
# Reverse proxy: "caddy" starts the bundled Caddy (automatic HTTPS). With your own proxy
# (nginx, Traefik, ...) leave it empty and forward to 127.0.0.1:BARDESK_PORT (see README).
COMPOSE_PROFILES=caddy
BARDESK_PORT=8000
